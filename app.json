{
  "expo": {
    "name": "qr-toolkit",
    "slug": "qr-toolkit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "qrtoolkit",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow QR Toolkit to use camera to scan QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow QR Toolkit to access photos to scan QR codes.",
        "NSPhotoLibraryAddUsageDescription": "Allow QR Toolkit to save QR codes to your photo library."
      }
    },
    "android": {
      "package": "com.israeldave23.qrtoolkit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QR Toolkit to use camera to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QR Toolkit to access photos to scan QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow QR Toolkit to save QR codes to your photo library."
        }
      ],
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5236559514557783~1339048038",
          "iosAppId": "ca-app-pub-5236559514557783~1458002511",
          "optimizeInitialization": true,
          "optimizeAdLoading": true,
          "userTrackingUsageDescription": "Used to show personalized ads."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6ffe5eca-6cec-4075-b39e-6603c5692fca"
      }
    },
    "owner": "israeldave23"
  }
}
